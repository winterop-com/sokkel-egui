diff --git a/src/tokens.test.ts b/src/tokens.test.ts
index b022eccf..84dd9792 100644
--- a/src/tokens.test.ts
+++ b/src/tokens.test.ts
@@ -4,6 +4,8 @@ import { join } from 'node:path'
 
 import { describe, expect, it } from 'vitest'
 
+import { hex, mix, oklch, type ResolvedTokens } from '../scripts/resolve-tokens'
+
 interface Tokens {
     themes: Record<string, { light?: Record<string, string>; dark?: Record<string, string> }>
 }
@@ -142,3 +144,31 @@ describe('the theme files', () => {
         expect(resolve('@winterop-com/sokkel-ui/themes.css')).toBe(join(styles, 'themes.css'))
     })
 })
+
+describe('the resolved tokens', () => {
+    const resolved = JSON.parse(
+        readFileSync(join(__dirname, '..', 'packages', 'core', 'tokens', 'tokens.resolved.json'), 'utf8'),
+    ) as ResolvedTokens
+    it('turn oklch into the sRGB a browser draws', () => {
+        expect(hex(oklch(0.5, 0.12, 240))).toBe('#006aa0')
+        expect(hex(oklch(0.985, 0.002, 255))).toBe('#f9fafb')
+    })
+    it('mix with transparent as CSS does, keeping the color and scaling its alpha', () => {
+        expect(hex(mix('oklch', oklch(0.5, 0.12, 240), 0.08, { l: 0, a: 0, b: 0, alpha: 0 }, null))).toBe('#006aa014')
+    })
+    it('settle every theme in light and dark, with no CSS left in a value', () => {
+        expect(Object.keys(resolved.themes)).toEqual(Object.keys(tokens.themes))
+        for (const theme of Object.values(resolved.themes)) {
+            for (const scheme of [theme.light, theme.dark]) {
+                expect(Object.keys(scheme.colors).length).toBeGreaterThan(100)
+                for (const value of Object.values(scheme.colors)) expect(value).toMatch(/^#[0-9a-f]{6}([0-9a-f]{2})?$/)
+                for (const value of Object.values(scheme.words)) expect(value).not.toMatch(/var\(|oklch\(|color-mix\(/)
+            }
+        }
+    })
+    it('export the resolved tokens as tokens.resolved.json', () => {
+        expect(createRequire(import.meta.url).resolve('@winterop-com/sokkel-ui/tokens.resolved.json')).toBe(
+            join(__dirname, '..', 'packages', 'core', 'tokens', 'tokens.resolved.json'),
+        )
+    })
+})
